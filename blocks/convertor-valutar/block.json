{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "curs-bnr-convertor-valutar/convertor-valutar",
  "title": "BNR Currency Converter",
  "category": "widgets",
  "icon": "exchange",
  "description": "Interactive currency conversion form based on BNR exchange rates.",
  "keywords": ["bnr", "currency converter", "exchange"],
  "textdomain": "curs-bnr-convertor-valutar",
  "supports": {
    "html": false
  },
  "attributes": {
    "de_la": {
      "type": "string",
      "default": "EUR"
    },
    "catre": {
      "type": "string",
      "default": "RON"
    },
    "tema": {
      "type": "string",
      "default": "implicit"
    },
    "densitate": {
      "type": "string",
      "default": "implicit"
    }
  },
  "editorScript": "file:../../build/index.js",
  "style": "onuexra-style"
}
